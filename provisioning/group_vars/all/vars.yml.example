---
# Copy to group_vars/all/vars.yml. Non-secret defaults for the DC build --
# actual secrets live in group_vars/all/vault.yml (see vault.yml.example,
# and encrypt it with ansible-vault) and are referenced here.

esxi_hostname: "{{ vault_esxi_hostname }}"
esxi_username: "{{ vault_esxi_username }}"
esxi_password: "{{ vault_esxi_password }}"
esxi_validate_certs: false  # standalone ESXi with a self-signed cert
esxi_ssh_host: esxi-host  # inventory hostname for vim-cmd tasks (markastemplate etc.) -- see inventory.ini.example

template_guest_user: "{{ vault_template_guest_user }}"
template_guest_password: "{{ vault_template_guest_password }}"
dsrm_password: "{{ vault_dsrm_password }}"

# --- Template prep (prepare_dc_template.yml, run once) ---
source_vm_name: "FileServer"        # existing VM to generalize into a template
dc_template_name: "dc-template-2012r2"  # name it's marked as after markastemplate

# --- Per-deployment (build_domain_controller.yml, prompted at runtime) ---
# oob_port_group: "Tools"           # OOB management network (VLAN 99) -- DHCP
# inband_port_group: "Vlan20"       # in-band services network -- static
# domain_name: "lab.local"
# dc_ip: "10.20.20.2"                # network base + .2 default
# dc_netmask: "255.255.255.0"
# dc_gateway: "10.20.20.1"
# dns_forwarder_ip: "192.168.200.1"  # pfSense
# dc_reverse_zone_name: "20.20.10.in-addr.arpa"
