---
# Copy to group_vars/all/vault.yml and encrypt it:
#   ansible-vault encrypt group_vars/all/vault.yml
# Never commit an unencrypted vault.yml. Everything in group_vars/all/ is
# auto-loaded for every play, so these vault_<name> values are available
# to reference from group_vars/all/vars.yml (or -e on the command line)
# without a vars_files: entry. Never inline a real secret in a playbook.

# ESXi/vCenter API credentials (community.vmware modules, scripts/vmware_guestexec.py)
vault_esxi_hostname: "192.168.99.25"
vault_esxi_username: "root"
vault_esxi_password: "changeme"

# Local admin credentials on the template source VM / clones, used for
# guest-ops during prep and WinRM after clone (over the OOB NIC only).
vault_template_guest_user: "changeme"
vault_template_guest_password: "changeme"

# Directory Services Restore Mode (DSRM) password for the new forest --
# required by dcpromo, needed again for any future authoritative restore.
vault_dsrm_password: "changeme"
